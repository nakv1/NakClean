<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NakClean</AssemblyName>
    <RootNamespace>NakClean</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.6.1</Version>
    <Company>nak</Company>
    <Authors>nak</Authors>
    <Product>NakClean</Product>
    <AssemblyTitle>NakClean - System Cleaner &amp; Optimizer</AssemblyTitle>
    <NeutralLanguage>en</NeutralLanguage>
    <Copyright>© 2026 nak (github.com/nakv1). Все права защищены. All rights reserved.</Copyright>
    <Description>NakClean — честный чистильщик и оптимизатор Windows. Автор: nak (github.com/nakv1).</Description>
    <!-- Экономный сборщик мусора: рабочий (не серверный) режим использует меньше памяти,
         неконкурентный режим возвращает память ОС агрессивнее (после скана делаем GC.Collect). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Первопартийные пакеты Microsoft: WMI (здоровье дисков) и журнал событий (анализ загрузки). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Сборщик мусора чаще уплотняет память, а не раздувает кучу (0 - выкл, 9 - максимум) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

</Project>
